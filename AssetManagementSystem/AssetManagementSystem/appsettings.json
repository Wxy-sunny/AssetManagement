{
	// 日志由 Serilog 接管（见 Program.cs）：控制台 + logs/ 文件双写。
	// 此处的 Logging 节仅为 ASP.NET Core 内置日志的兼容配置，实际级别以代码中的 Serilog 配置为准。
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"AssetManagementSystem": "Information"
		}
	},
	// 数据库连接字符串：生产环境必须通过环境变量 ConnectionStrings__AssetConnection 注入，不要在此提交任何真实凭据。
	// 本地开发的连接串放在 appsettings.Development.json（仅 Development 环境加载）。
	"ConnectionStrings": {
		"AssetConnection": ""
	},
	"SqlSugarConfig": {
		"DbType": "sqlserver",
		"IsAutoCloseConnection": true,
		"LogSql": false
	},
	// 自动建表/结构补齐：正式环境请设为 false（首次部署可临时设为 true 初始化表结构，完成后改回 false）
	"DatabaseInitialization": {
		"Enabled": false,
		"CreateTablesOnStartup": false,
		"DropTablesFirst": false
	},

	// JWT 签名密钥：留空则启动时生成一次性随机密钥（重启后旧 token 失效，仅适合本地开发）。
	// 生产环境务必通过环境变量 Jwt__SecretKey 设置一个稳定且足够长的密钥（≥32 字节）。
	"Jwt": {
		"SecretKey": "",
		"Issuer": "AssetManagementSystem",
		"Audience": "AssetManagementSystem",
		"ExpireMinutes": 120,
		"RefreshExpireDays": 7
	},

	"Redis": {
		"Connection": "localhost:6379" // 本机 Redis，用于验证码存储；不可用时自动降级为内存缓存
	},

	// 系统管理员初始化：Password 留空时将在首次初始化时生成随机密码并打印到日志，请登录后立即修改。
	// 生产环境建议通过环境变量 AdminSeed__Password 指定强密码。
	"AdminSeed": {
		"Enabled": true,
		"UserId": "admin",
		"UserName": "系统管理员",
		"Password": "",
		"RoleId": "admin",
		"RoleName": "系统管理员"
	},

	// 演示数据：正式环境请保持 false
	"DemoData": {
		"Enabled": false
	},

	// 短信验证码：未接入真实短信网关时把验证码回传前端仅用于本地联调；生产环境必须 false
	"Sms": {
		"ReturnCodeInResponse": false
	},

	// 登录防爆破：同一账号在 FailWindowMinutes 内连续失败 MaxFailures 次即锁定 LockMinutes 分钟；
	// IP 限流默认关闭（反向代理部署时 RemoteIpAddress 为代理地址，需先配置 ForwardedHeaders 再开启）
	"LoginGuard": {
		"MaxFailures": 5,
		"FailWindowMinutes": 10,
		"LockMinutes": 15,
		"IpLimitEnabled": false,
		"IpMaxFailures": 30
	},

	// 跨域：允许访问前端站点的来源（逗号分隔）；生产环境请改为实际部署的前端域名
	"Cors": {
		"AllowedOrigins": "http://localhost:5173,http://localhost:4173"
	},

	"AllowedHosts": "*"
}
