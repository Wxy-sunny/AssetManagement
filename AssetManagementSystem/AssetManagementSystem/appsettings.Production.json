{
  // ============================================================
  // 生产环境配置（ASPNETCORE_ENVIRONMENT=Production 时覆盖 appsettings.json）
  // 原则：所有机密一律走环境变量注入，本文件不落任何真实凭据。
  // 环境变量命名：层级用双下划线，如 Jwt__SecretKey、ConnectionStrings__AssetConnection。
  // ============================================================
  "Logging": {
    // 生产降低日志噪音（Serilog 仍按自身配置落盘）
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // 主机白名单：演示经 cloudflared 隧道的域名是 *.trycloudflare.com；本地自测用 localhost；
  // 上线前把 example.com 改成你的真实域名（保留 localhost / *.trycloudflare.com 亦可，或收紧为 *）。
  // 注意：.NET 10 不按逗号拆分字符串，必须以 JSON 数组形式书写，否则整串被视为单一条目导致全部 400。
  "AllowedHosts": ["localhost", "*.trycloudflare.com", "example.com", "www.example.com", "127.0.0.1", "43.139.59.222"],

  // 跨域：只允许你的前端域名；HTTPS 优先。多个用逗号分隔。
  // （隧道/本地均为前端与 API 同源，通常不触发 CORS；此处保留 localhost 便于直接浏览器自测）
  "Cors": {
    "AllowedOrigins": "http://localhost:8080,https://localhost,https://example.com,https://www.example.com,http://43.139.59.222"
  },

  // 数据库连接串：必须改用环境变量注入
  //   ConnectionStrings__AssetConnection="Server=...;Database=...;User Id=...;Password=...;"
  "ConnectionStrings": {
    "AssetConnection": ""
  },

  // JWT 签名密钥：必须改用环境变量注入一个稳定且≥32字节的密钥
  //   Jwt__SecretKey="<base64 或任意长随机串，≥32字节>"
  // 不配置则生产环境启动直接失败（Fail-Fast，见 Program.cs）。
  "Jwt": {
    "SecretKey": "",
    "Issuer": "AssetManagementSystem",
    "Audience": "AssetManagementSystem"
  },

  // 自动建表：生产应保持关闭，首次部署可临时 true 初始化表结构后改回 false
  "DatabaseInitialization": {
    "Enabled": false,
    "CreateTablesOnStartup": false,
    "DropTablesFirst": false
  },

  // 演示数据：生产必须 false（否则会种入 123456 演示账号）
  "DemoData": {
    "Enabled": false
  },

  // 管理员初始化：生产建议通过环境变量 AdminSeed__Password 指定强密码；
  // 留空则首次初始化生成随机密码并打印到控制台，请登录后立即修改。
  "AdminSeed": {
    "Enabled": true,
    "UserId": "admin",
    "UserName": "系统管理员",
    "Password": ""
  },

  // 反向代理信任：若 nginx/Caddy 与 API 不在同一台机，请把代理 IP 填入 TrustedProxies
  // （逗号分隔，如 "127.0.0.1,10.0.0.5"）；CIDR 可填 TrustedNetworks（如 "10.0.0.0/8"）。
  // 不信任代理会导致客户端真实 IP 取错（影响 IP 限流与登录守卫）。
  "ReverseProxy": {
    "TrustedProxies": "127.0.0.1,::1",
    "TrustedNetworks": ""
  },

  // 短信验证码：生产必须 false（true 会把验证码明文回传前端，仅供本地联调）
  "Sms": {
    "ReturnCodeInResponse": false
  }
}
