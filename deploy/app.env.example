# ============================================================
# 生产环境变量模板（复制为 /etc/asset-api/app.env 后填入真实值）
# 切勿把含真实凭据的 .env 提交到仓库（已被 .gitignore 忽略 *.env）。
# 由 systemd 的 EnvironmentFile= 加载（见 asset-api.service）。
# ============================================================

# 1) 必须：生产环境标识（启用安全头 / HTTPS 重定向 / 关闭 Swagger）
ASPNETCORE_ENVIRONMENT=Production

# 2) 必须：JWT 签名密钥（≥32 字节的稳定随机串；多实例/重启必须一致，否则旧 token 全部失效）
#    Linux 生成示例：
#      python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#      # 或
#      openssl rand -base64 48
Jwt__SecretKey=CHANGE_ME_TO_A_STABLE_RANDOM_KEY_AT_LEAST_32_BYTES

# 3) 必须：SQL Server 连接串（含密码）
#    示例（本机）：Server=127.0.0.1,1433;Database=AssetDB;User Id=asset_app;Password=CHANGE_ME;TrustServerCertificate=True;
ConnectionStrings__AssetConnection=Server=127.0.0.1,1433;Database=AssetDB;User Id=asset_app;Password=CHANGE_ME;TrustServerCertificate=True;

# 4) 可选：管理员初始密码。
#    留空则首次启动随机生成强密码并打印到启动日志（stdout），登录后立即在"角色权限"修改。
#    生产建议显式设置一个强密码。
AdminSeed__Password=CHANGE_ME_OR_LEAVE_EMPTY_FOR_RANDOM

# 5) 可选：反向代理信任。
#    若 nginx 与本服务同机，默认回环即可；跨机部署请在此追加代理服务器 IP（逗号分隔）。
#    未信任代理会导致 X-Forwarded-For 被误读，影响 IP 限流与登录守卫。
ReverseProxy__TrustedProxies=127.0.0.1,::1

# 6) 可选：Redis（缺失时验证码自动降级为内存缓存，多实例部署建议配置以保证限流/验证码一致）
Redis__Connection=127.0.0.1:6379

# 7) 可选：登录 IP 限流（同机代理无需开启；跨机且已正确配置 5 的 TrustedProxies 后再开启）
LoginGuard__IpLimitEnabled=false
